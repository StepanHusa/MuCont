{
  "name": "System with dependencies",
  "coordinates": ["x", "y"],
  "parameters": ["a", "b", "c", "d"],
  "functions": [],
  "equations": [
    ["x", "x + exp(y)"],
    ["y", "log(c+y) + y^0.5 + sin(x) - tanh(x) + sqrt(y)"]
  ],
  "displayfunctions": [
    ["total_population", "x + y"]
  ],
  "latexnaming": {
    "x": "x",
    "y": "y",
    "a": "\\alpha",
    "b": "\\beta",
    "c": "\\gamma",
    "d": "\\delta",
    "total_population": "x + y"
  }
}
