{
  "name": "System with dependencies",
  "coordinates": ["x", "y"],
  "parameters": ["a", "b", "c", "d"],
  "functions": [
    ["f1","x+a"],
    ["f2","f1*b"]
    ],
  "equations": [
    ["x", "f1 + 17"],
    ["y", "-c * y + d * x * y - f2"]
  ],
  "displayfunctions": [
    ["total_population", "x + y"]
  ],
  "latexnaming": {
    "x": "x",
    "y": "y",
    "a": "\\alpha",
    "b": "\\beta",
    "c": "\\gamma",
    "d": "\\delta",
    "total_population": "x + y"
  }
}
