<UserControl
    x:Class="MuCont.Desktop.Views.Dockable.Plots.PlotView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="using:OxyPlot.Avalonia"
    xmlns:vm="using:MuCont.Desktop.ViewModels.Dockable.Plots"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:PlotViewModel"
    mc:Ignorable="d">

	<Design.DataContext>
		<vm:PlotViewModel />
	</Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Curve Selection  -->
        <ListBox
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding AvailableCurves}"
            SelectedItems="{Binding SelectedCurves}"
            SelectionMode="Multiple" />

        <!--  Plot View  -->
        <oxy:PlotView
            Grid.Column="1"
            Model="{Binding PlotModel}" />
    </Grid>
</UserControl>