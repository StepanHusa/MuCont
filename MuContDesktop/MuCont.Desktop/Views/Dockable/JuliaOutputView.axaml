<UserControl
    x:Class="MuCont.Desktop.Views.Dockable.JuliaOutputView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MuCont.Desktop.ViewModels.Dockable"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:JuliaOutputViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock
            Margin="10"
            FontSize="14"
            Text="{Binding StatusMessage}" />



        <TextBox
            Grid.Row="2"
            Margin="10"
            AcceptsReturn="True"
            IsReadOnly="True"
            Text="{Binding Output}" />

        <ProgressBar
            Grid.Row="3"
            Height="5"
            Margin="10"
            IsIndeterminate="True"
            IsVisible="{Binding IsRunning}" />
    </Grid>
</UserControl>
